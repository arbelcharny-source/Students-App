<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".StudentDetailsActivity"
    tools:ignore="HardcodedText,ContentDescription,Autofill,ButtonStyle">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/detailsStudentImageView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:src="@android:drawable/sym_def_app_icon"
                android:layout_marginTop="80dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/detailsNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:layout_marginBottom="8dp"
                tools:text="Name: Israel Israeli" />

            <TextView
                android:id="@+id/detailsIdTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:layout_marginBottom="8dp"
                tools:text="ID: 123456789" />

            <TextView
                android:id="@+id/detailsPhoneTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:layout_marginBottom="8dp"
                tools:text="Phone: 054-1234567" />

            <TextView
                android:id="@+id/detailsAddressTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:layout_marginBottom="8dp"
                tools:text="Address: Tel Aviv" />

            <CheckBox
                android:id="@+id/detailsCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checked"
                android:enabled="false"
                android:minHeight="48dp"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/detailsEditButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:minHeight="48dp"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>