<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".EditStudentActivity"
    tools:ignore="HardcodedText,ContentDescription,Autofill,ButtonStyle,TextFields">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:src="@android:drawable/sym_def_app_icon"
                android:layout_marginTop="80dp"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/editStudentNameEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name"
                android:inputType="text|textNoSuggestions"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/editStudentIdEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ID"
                android:inputType="number"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/editStudentPhoneEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phone"
                android:inputType="phone"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/editStudentAddressEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Address"
                android:inputType="text|textNoSuggestions"
                android:minHeight="48dp" />

            <CheckBox
                android:id="@+id/editStudentCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checked"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp">

                <Button
                    android:id="@+id/editStudentCancelButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:minHeight="48dp"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/editStudentDeleteButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delete"
                    android:minHeight="48dp"
                    android:backgroundTint="#FF0000"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/editStudentSaveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save"
                    android:minHeight="48dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>